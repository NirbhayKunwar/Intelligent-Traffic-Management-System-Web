# ==============================================================================
# Environment Template - Intelligent Traffic Management System (ITMS)
# ==============================================================================

# Server & Client Configuration
PORT=4000
NODE_ENV=production
JWT_SECRET=YOUR_SECURE_JWT_SECRET
JWT_REFRESH_SECRET=YOUR_SECURE_JWT_REFRESH_SECRET
CLIENT_ORIGIN=http://localhost:5173
SERVER_URL=http://localhost:4000

# Frontend build-time API origin.
# For Vercel frontend + separate backend, set this in Vercel to your backend origin, e.g. https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:4000

# Database Configuration
# Set up MongoDB Atlas connection uri
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/itms

# Authentication (Google OAuth 2.0)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Cloudinary (Media Upload & Hosting)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Model Service Integration
# The AI microservice listens locally inside the container environment
MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_TIMEOUT_MS=90000
MODEL_SERVICE_STRICT=false

# External Model Storage Paths
ACCIDENT_MODEL_PATH=apps/ai/models/Accident model/best.pt
CONGESTION_MODEL_PATH=apps/ai/models/Congestion model/traffic-model.pt

# Emergency Alerts (Nodemailer Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-specific-password
