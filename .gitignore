# ============================================================
# ITMS — Intelligent Traffic Management System
# Root .gitignore
# ============================================================

# ─── Node / JavaScript ──────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.vite/
.next/

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/
.Python

# Python packaging
*.egg-info/
*.egg
*.whl

# ─── Secrets & Environment Variables (CRITICAL) ─────────────
.env
.env.local
.env.*.local
.env.development
.env.production
apps/api/data/.env

# ─── Database ───────────────────────────────────────────────
apps/api/data/db.json

# ─── Uploaded User Files ────────────────────────────────────
apps/api/uploads/

# ─── Large AI Model Weights ─────────────────────────────────
# YOLOv5/YOLOv8 .pt files are 6–170MB — too large for Git
# Download them separately via requirements or release assets
apps/ai/*.pt
apps/ai/*.onnx
apps/ai/weights/
apps/ai/models/**/*.pt

# ─── Sample Video Datasets ──────────────────────────────────
# Large .mp4 files should NOT be committed to Git.
apps/ai/models/**/*.mp4
apps/ai/models/**/*.avi
apps/ai/models/**/*.mkv
apps/ai/models/**/*.mov
apps/ai/models/**/*.webm

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── OS Specific ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDE / Editor ────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.user
*.sublime-project
*.sublime-workspace
*.ntvs*
*.njsproj
*.sln

# ─── Misc ───────────────────────────────────────────────────
*.bak
*.tmp
*.sw?
.cache/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
